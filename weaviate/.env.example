# Weaviate -- vector store do rag_orchestrator.
# Copie para .env e preencha. (.env nao versionado)
#
# Cada ambiente tem seu proprio .env: o local usa uma key de dev, a EC2 uma key
# forte propria. Os dois composes (docker-compose.yaml e docker-compose.ec2.yaml)
# leem as MESMAS variaveis.

# API key do Weaviate. Gerar: openssl rand -base64 32
# ESPELHAR em rag_orchestrator/.env -> VECTOR_STORE_API_KEY (tem que ser identico).
WEAVIATE_API_KEY=

# Usuario associado a key. Default: rag_orchestrator
WEAVIATE_API_USER=rag_orchestrator
