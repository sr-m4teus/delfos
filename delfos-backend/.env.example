# Server Configuration
PORT=3001
NODE_ENV=development

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=delfos
POSTGRES_USER=delfos_user
POSTGRES_PASSWORD=delfos_password
DB_SCHEMA=delfos

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Set REDIS_TLS=true for managed/cloud Redis (Upstash, Redis Cloud). Leave empty for local Docker.
REDIS_TLS=
SESSION_TTL=3600
SESSION_PREFIX=delfos:sess:

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=3600

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# OpenRouter Configuration
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Modelo :free funciona com política "Free model publication". Para usar openai/gpt-4o-mini, configure em https://openrouter.ai/settings/privacy
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_TEMPERATURE=0.3
OPENROUTER_MAX_TOKENS=2000
OPENROUTER_HTTP_REFERER=https://delfos.local
OPENROUTER_X_TITLE=Delfos

# Trino Configuration (federação de queries nos bancos-alvo)
# Local: http://localhost:8081. Produção: VM Oracle exposta direto via HTTPS, ex https://<IP-PUBLICO>:8443
TRINO_URL=http://localhost:8081
TRINO_TIMEOUT=30000
TRINO_USER=delfos_user
TRINO_CATALOG=default
# Senha do Trino (PASSWORD authenticator). Mesma do password.db gerado na VM. Vazio = Trino sem auth.
TRINO_PASSWORD=
# Aceitar cert self-signed do Trino (HTTPS na VM Oracle). true em produção; vazio/false local.
TRINO_TLS_INSECURE=
# Proxy SOCKS5 (legado Tailscale). Exposição direta não usa — deixe VAZIO.
TRINO_SOCKS_PROXY=

# RAG Orchestrator Configuration
RAG_ORCHESTRATOR_URL=http://localhost:8001
RAG_ORCHESTRATOR_TIMEOUT=30000
# Registrar automaticamente queries executadas (com dados) no RAG como contexto por tabela. Use false para desabilitar.
RAG_REGISTER_EXECUTED_QUERIES=true
