# PostgreSQL Environment Variables for Delfos
# Copy this file to .env and update values as needed

# Database Configuration
POSTGRES_DB=delfos
POSTGRES_USER=delfos_user
POSTGRES_PASSWORD=delfos_password

# Admin inicial -- criado por init-scripts/03-create-admin-user.sql na PRIMEIRA
# subida (criacao do volume). Deixe vazio para nao criar nenhum admin e registrar
# o primeiro usuario via POST /api/auth/register.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Connection Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=prefer

# Connection Pool (for application)
DB_MAX_CONNECTIONS=20
DB_CONNECTION_TIMEOUT=5000
DB_IDLE_TIMEOUT=30000

# Application Settings
DB_SCHEMA=delfos
DB_TIMEZONE=UTC

# Health Check
DB_HEALTH_CHECK_INTERVAL=10000

# Migration Settings
DB_MIGRATIONS_PATH=./migrations
DB_MIGRATIONS_TABLE=migrations
