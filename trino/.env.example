# Trino -> bancos alvo na cloud. Copie para .env e preencha. (.env nao versionado)

# Segredo interno do Trino (obrigatorio com auth). Gerar: openssl rand -hex 32
TRINO_SHARED_SECRET=

# Supabase (projeto delfos-targets) -- catalog supabase_targets
SUPABASE_TARGETS_HOST=db.<REF>.supabase.co
SUPABASE_TARGETS_PORT=5432
SUPABASE_TARGETS_DB=postgres
SUPABASE_TARGETS_USER=postgres.<REF>
SUPABASE_TARGETS_PASSWORD=

# MongoDB Atlas -- catalog mongodb_telemetria
# URI completa do cluster, com /db_telemetria no fim
ATLAS_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/db_telemetria
