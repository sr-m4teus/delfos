# Vector Store Configuration (Weaviate local: use http://localhost:8080)
VECTOR_STORE_URL=http://localhost:8080
VECTOR_STORE_API_KEY=your_api_key_here
VECTOR_STORE_TIMEOUT=5.0

# Collections
SCHEMA_COLLECTION=database_schemas
QUERY_COLLECTION=validated_queries

# Limits
DEFAULT_MAX_RESULTS=10
MAX_MAX_RESULTS=100
DEFAULT_MIN_RELEVANCE_SCORE=0.6
SCHEMA_CATALOG_MAX_FETCH=500

# Embedding (mesmo modelo para insert e search; local, sem API paga)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# API Configuration
API_TITLE=RAG Orchestrator API
API_VERSION=1.0.0
